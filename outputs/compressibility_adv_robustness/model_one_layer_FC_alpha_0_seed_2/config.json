{
  "experiment": {
    "name": "model_one_layer_FC_alpha_0",
    "output_dir": "outputs",
    "seed": 2,
    "device": "auto"
  },
  "dataset": {
    "name": "mnist",
    "root": "./data",
    "num_classes": 2,
    "binary": true,
    "val_fraction": 0.05,
    "augmentation": {
      "random_crop": 0,
      "horizontal_flip": false,
      "normalize": true
    },
    "noise": {
      "label_noise_fraction": 0.0
    }
  },
  "dataloader": {
    "batch_size": 256,
    "num_workers": 4,
    "pin_memory": true
  },
  "model": {
    "name": "fcn",
    "input_shape": [
      1,
      28,
      28
    ],
    "hidden_dims": [
      400
    ],
    "dropout": 0.0,
    "bias": false
  },
  "optimizer": {
    "type": "adamw",
    "lr": 0.001,
    "weight_decay": 0.01
  },
  "training": {
    "epochs": 100,
    "criterion": "cross_entropy",
    "label_smoothing": 0.0,
    "early_stopping_patience": 10
  },
  "paper": {
    "name": "on_the_interaction_between_compressibility_and_adversarial_robustness",
    "experiment": "testing_the_motivating_hypothesis",
    "regularization": {
      "type": "nuclear_norm",
      "alpha": 0.0
    },
    "normalization": {
      "type": "frobenius",
      "apply_every_iteration": true
    }
  }
}